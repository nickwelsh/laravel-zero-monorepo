{
    "name": "laravel-zero-monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "vp test run",
        "typecheck": "tsc --noEmit && pnpm docs:typecheck",
        "build": "pnpm --filter @nickwelsh/laravel-zero build && pnpm docs:build",
        "docs:dev": "pnpm --filter @laravel-zero/docs dev",
        "docs:build": "pnpm --filter @laravel-zero/docs build",
        "docs:start": "pnpm --filter @laravel-zero/docs start",
        "docs:typecheck": "pnpm --filter @laravel-zero/docs typecheck",
        "contracts:check": "node scripts/check-generated.mjs",
        "package:check": "node scripts/check-package.mjs",
        "format": "vp fmt && pnpm php:format",
        "format:check": "vp fmt --check && pnpm php:format:check",
        "lint": "vp lint --fix && pnpm lint:markdown --fix",
        "lint:check": "vp lint && pnpm lint:markdown && pnpm php:analyse && pnpm php:rector:check && pnpm php:peck",
        "lint:markdown": "markdownlint-cli2",
        "php:test": "composer --working-dir=packages/laravel test",
        "php:format": "composer --working-dir=packages/laravel format",
        "php:format:check": "composer --working-dir=packages/laravel format:check",
        "test:coverage": "vp test run --coverage",
        "php:analyse": "composer --working-dir=packages/laravel analyse",
        "php:rector": "composer --working-dir=packages/laravel rector",
        "php:rector:check": "composer --working-dir=packages/laravel rector:check",
        "php:peck": "composer --working-dir=packages/laravel peck",
        "php:test:coverage": "composer --working-dir=packages/laravel test:coverage",
        "php:check": "composer --working-dir=packages/laravel check",
        "check": "pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm php:test && pnpm test && pnpm contracts:check && pnpm build && pnpm package:check",
        "docs:generate": "pnpm --filter @laravel-zero/docs api:generate"
    },
    "devDependencies": {
        "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
        "@rocicorp/zero": "1.10.0",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.0.0",
        "@vitest/coverage-v8": "4.1.11",
        "eslint-plugin-no-only-tests": "^3.4.0",
        "eslint-plugin-no-use-extend-native": "^0.7.3",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-regexp": "^3.1.0",
        "jsdom": "^27.0.0",
        "markdownlint-cli2": "^0.23.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^6.0.2",
        "ulid": "^3.0.0",
        "uuid": "^13.0.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
        "vite-plus": "0.3.3"
    },
    "engines": {
        "node": "^22.18.0 || >=24.11.0"
    },
    "packageManager": "pnpm@11.24.0"
}
