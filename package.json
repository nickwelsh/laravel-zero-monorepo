{
    "name": "laravel-zero-monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "vp test run",
        "typecheck": "tsc --noEmit",
        "build": "pnpm --filter @laravel-zero/client build",
        "contracts:check": "node scripts/check-generated.mjs",
        "package:check": "node scripts/check-package.mjs",
        "format": "vp fmt",
        "format:check": "vp fmt --check",
        "lint": "vp lint --fix && pnpm lint:markdown --fix",
        "lint:check": "vp lint && pnpm lint:markdown",
        "lint:markdown": "markdownlint-cli2",
        "php:test": "composer --working-dir=packages/laravel test",
        "php:format": "composer --working-dir=packages/laravel format",
        "php:format:check": "composer --working-dir=packages/laravel format:check"
    },
    "devDependencies": {
        "@rocicorp/zero": "1.10.0",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "eslint-plugin-no-only-tests": "^3.4.0",
        "eslint-plugin-no-use-extend-native": "^0.7.3",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-regexp": "^3.1.0",
        "jsdom": "^27.0.0",
        "markdownlint-cli2": "^0.23.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^6.0.2",
        "ulid": "^3.0.0",
        "uuid": "^13.0.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
        "vite-plus": "^0.3.3"
    },
    "engines": {
        "node": "^22.18.0 || >=24.11.0"
    },
    "packageManager": "pnpm@11.24.0"
}
