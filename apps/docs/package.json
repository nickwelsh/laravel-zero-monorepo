        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-server-dom-webpack": "19.3.1",
        "waku": "1.0.0-rc.3"
    },
    "devDependencies": {
        "@nickwelsh/refquill": "0.1.0",
        "@types/node": "^22.20.5",
        "typescript": "^6.0.2"
