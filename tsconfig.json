{
    "compilerOptions": {
        "noEmit": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "types": ["node", "vite-plus/test/globals"],
        "paths": {
            "@laravel-zero/client": ["./packages/client/src/index.ts"],
            "@laravel-zero/client/react": ["./packages/client/src/react/index.ts"]
        }
    },
    "include": ["packages", "tests/interop", "vite.config.ts"]
}
